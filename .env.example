# ============================================================================
# PENEIRAS ON — variáveis de ambiente (MODELO). NÃO coloque valores reais aqui.
# Copie mentalmente cada nome e configure os valores em:
#   Vercel → Project → Settings → Environment Variables  (para as funções /api)
# Para o build do frontend, defina SUPABASE_URL e SUPABASE_ANON_KEY (públicas).
# Segredos (service_role, HMAC, encryption, SMTP) SÓ no servidor — nunca no build
# público, nunca no Git, nunca colados no chat.
# ============================================================================

# --- Públicas (usadas no build do frontend e nas funções) -------------------
SUPABASE_URL=https://kajdfncwgqenhdkrfzyo.supabase.co
SUPABASE_ANON_KEY=            # chave anon/publishable (pública)
SITE_URL=https://peneirason.vercel.app

# --- Segredos de servidor (SOMENTE nas funções /api da Vercel) --------------
SUPABASE_SERVICE_ROLE_KEY=    # Project Settings → API → service_role (secreta)

# Chaves HMAC/criptografia — gere valores aleatórios fortes e faça backup seguro.
# Ex.: gerar com  ->  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CPF_HMAC_KEY=                 # >=32 bytes; estável (trocar quebra login por CPF)
CPF_HMAC_KEY_VERSION=v1
OTP_HMAC_KEY=                 # >=32 bytes; exclusiva do código de login
AUTH_SESSION_ENCRYPTION_KEY=  # 32 bytes em base64 (AES-256-GCM da sessão pendente)
AUTH_COOKIE_HMAC_KEY=         # opcional; se vazio, reutiliza OTP_HMAC_KEY

# --- Provedor de e-mail transacional (para enviar o código de login) --------
# Opção A (recomendada): Resend
RESEND_API_KEY=
AUTH_MAIL_FROM=Peneiras On <no-reply@peneirason.vercel.app>   # remetente verificado
# Opção B: SMTP próprio (requer dependência nodemailer)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- CAPTCHA (opcional; se ausente, não bloqueia no MVP) --------------------
# Turnstile (Cloudflare): a site key é pública (no formulário); o secret é servidor.
CAPTCHA_SECRET=
# CAPTCHA_SITE_KEY=           # se usar, exponha no config público do frontend

# --- Origens extras permitidas (CORS), separadas por vírgula ----------------
EXTRA_ALLOWED_ORIGINS=
