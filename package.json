{
  "name": "peneiras-on",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "Peneiras On — front-end (HTML + Tailwind CSS v4 + JS vanilla) + auth MVP (Supabase + funções Vercel)",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --watch",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --minify",
    "build": "npm run build:css",
    "config": "node scripts/gerar-config.mjs",
    "build:site": "npm run build:css && npm run config && node scripts/build-dist.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
